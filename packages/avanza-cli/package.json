{
  "name": "avanza-tools",
  "version": "1.0.2",
  "description": "Command-line interface for Avanza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnteWall/avanza-ts.git",
    "directory": "packages/avanza-cli"
  },
  "bin": {
    "avanza": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "prepack": "pnpm build",
    "start": "node ./bin/run.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.0",
    "@oclif/core": "^5.0.0",
    "avanza-ts": "workspace:^",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  },
  "oclif": {
    "bin": "avanza",
    "commands": "./dist/commands",
    "dirname": "avanza",
    "topicSeparator": " ",
    "topics": {
      "accounts": {
        "description": "Read accounts and balances"
      },
      "auth": {
        "description": "Manage authentication and the stored session"
      },
      "collections": {
        "description": "Read watchlists, alerts, and instrument notes"
      },
      "funds": {
        "description": "Search, list, and inspect funds"
      },
      "instruments": {
        "description": "Screen stocks and other listed products, and manage stock settings"
      },
      "market": {
        "description": "Search instruments and read quotes, charts, indices, and ETFs"
      },
      "news": {
        "description": "Read news articles, the personal news feed, and the event calendar"
      },
      "orders": {
        "description": "Read orders, stop-losses, and trading status"
      },
      "performance": {
        "description": "Read account performance and total values"
      },
      "positions": {
        "description": "Read positions and statistics"
      },
      "savings": {
        "description": "Read recurring savings, savings goals, credit, and pensions"
      },
      "transactions": {
        "description": "Read transactions and dividends"
      }
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
