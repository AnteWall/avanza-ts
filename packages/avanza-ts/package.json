{
  "name": "avanza-ts",
  "version": "1.0.2",
  "description": "TypeScript SDK for Avanza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnteWall/avanza-ts.git",
    "directory": "packages/avanza-ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch --preserveWatchOutput",
    "prepack": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
