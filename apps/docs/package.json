{
  "name": "@avanza/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm generate:cli && pnpm generate:sdk && next build && node scripts/check-links.mjs",
    "dev": "pnpm generate:cli && pnpm generate:sdk && next dev",
    "generate:cli": "pnpm --dir ../../packages/avanza-cli build && node scripts/generate-cli.mjs",
    "generate:sdk": "typedoc --options typedoc.json && node scripts/prepare-sdk-reference.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.13",
    "fumadocs-mdx": "^15.4.3",
    "fumadocs-typescript": "^5.4.1",
    "fumadocs-ui": "^16.15.13",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oclif": "^6.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
